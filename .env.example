# iThome 登入帳號密碼（只有 cookies.txt 不存在/失效、需要重新登入時才會用到）
ITHOME_ACCOUNT=your_account_here
ITHOME_PASSWORD=your_password_here

# CI 用：cookies.txt 不存在時，Client.load_cookies() 會從這個環境變數的
# 內容寫出 cookies.txt（內容就是 cookies.txt 檔案本身，base64 編碼的
# cookies JSON）。本機開發不用設定，跑過一次登入後 cookies.txt 就會存在。
# ITHOME_COOKIES=

# CI 用：true 時 CLI（ithome-bot 指令）用 headless 模式啟動瀏覽器
# （無法手動處理 reCAPTCHA，只適合搭配已經有效的 cookies）
# 本機開發不要設定，或設成 false，才能在跳出 reCAPTCHA 時手動處理
# ITHOME_HEADLESS=false
